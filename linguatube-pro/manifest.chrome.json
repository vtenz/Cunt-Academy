{
  "manifest_version": 3,
  "name": "Cunt Academy — Language Reactor & Trancy 1:1 Free Edition",
  "version": "4.7.0",
  "description": "Cunt Academy v4.7: 100% Free YouTube Language Learning Extension for Chrome, Brave & Edge with Compact Toolbar Leitner Popup, Lexa AI Contextual Dictionary, Gmail Cloud Sync, and AnkiDroid SM-2 Flashcards.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googleapis.com/*",
    "*://translate.googleapis.com/*",
    "*://api.dictionaryapi.dev/*",
    "*://api.mymemory.translated.net/*",
    "*://tatoeba.org/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background-sw.js"
  },
  "action": {
    "default_title": "Cunt Academy v4.7 — جعبه لایتنر، فلش‌کارت AnkiDroid و ورود مستقیم به سایت",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/page-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/main-world-loader.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["src/content/content-styles.css"],
      "js": [
        "src/shared/constants.js",
        "src/shared/persian-utils.js",
        "src/shared/db.js",
        "src/content/subtitle-parser.js",
        "src/content/content-main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/page-interceptor.js",
        "src/dashboard/dashboard.html",
        "src/popup/popup.html",
        "icons/icon48.png",
        "icons/icon96.png",
        "icons/icon128.png"
      ],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
